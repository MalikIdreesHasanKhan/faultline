{
  "name": "faultline-remotion-film",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts FaultlineFilm out/faultline-demo.mp4 --codec=h264 --crf=22",
    "render:v2": "remotion render src/index.ts FaultlineFilmV2 out/faultline-demo-v2.mp4 --codec=h264 --crf=22",
    "render:quick": "remotion render src/index.ts FaultlineFilm out/faultline-preview.mp4 --codec=h264 --scale=0.5 --crf=23",
    "still": "remotion still src/index.ts FaultlineThumbnail out/faultline-thumbnail.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "icss-utils": "^5.1.0",
    "typescript": "^5.7.0"
  }
}
